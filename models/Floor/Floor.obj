# Floor.obj - Piso trapezoidal plano y extenso
# Modelo simple de un piso trapezoidal grande para el renderizador 3D

# Vértices del piso trapezoidal (formato: v x y z)
# Lado inferior: 250 unidades (-125 a +125), Lado superior: 462.5 unidades (-231.25 a +231.25)
# Trapecio centrado en el origen, a nivel Y=0, escalado 2.5x
v -125.0 0.0 -125.0   # Vértice inferior izquierdo
v  125.0 0.0 -125.0   # Vértice inferior derecho  
v  231.25 0.0  125.0   # Vértice superior derecho (1.85x más ancho, escalado 2.5x)
v -231.25 0.0  125.0   # Vértice superior izquierdo (1.85x más ancho, escalado 2.5x)

# Coordenadas de textura (formato: vt u v)
# Mapeo de textura completo para el piso
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normales (formato: vn x y z)
# Normal apuntando hacia arriba para toda la superficie
vn 0.0 1.0 0.0

# Caras del piso (formato: f v1/vt1/vn1 v2/vt2/vn2 v3/vt3/vn3)
# Dividido en 2 triángulos para formar un rectángulo
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1